# ==== ОБЯЗАТЕЛЬНО ====
# Токен бота от @BotFather. Это всё, что нужно для работы.
BOT_TOKEN=ваш_токен_бота_от_botfather

# ==== НЕОБЯЗАТЕЛЬНО (есть значения по умолчанию) ====

# Часовой пояс и время ежедневной рассылки.
TIMEZONE=Europe/Moscow
SEND_HOUR=8
SEND_MINUTE=0

# Отбор лучших новостей.
DIGEST_TARGET=25          # сколько топ-новостей в сводке (20-30)
MAX_PER_CHANNEL=5         # максимум постов от одного канала в топе
MIN_TEXT_LEN=40           # мин. длина текста для полного приоритета

# Параметры краткой выжимки.
SUMMARY_MAX_SENTENCES=2
SUMMARY_MAX_CHARS=400

# Парсер веб-версии каналов.
MAX_PAGES_PER_CHANNEL=30
REQUEST_DELAY=0.7
REQUEST_RETRIES=3

# Прокси для ВСЕГО трафика бота — нужен, только если сервер не имеет прямого
# доступа к Telegram (t.me / api.telegram.org). HTTP или SOCKS5.
# PROXY_URL=socks5://user:pass@host:1080

# Список каналов через запятую (если не задан — берётся встроенный из config.py).
# CHANNELS=prbezposhady,blogbankir,banksta
