# ==== ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ ====

# api_id и api_hash берутся на https://my.telegram.org -> "API development tools".
# Нужны, чтобы читать посты из каналов от имени вашего аккаунта (бот сам этого не умеет).
API_ID=123456
API_HASH=ваш_api_hash_отсюда

# Токен бота от @BotFather (этим ботом отправляется сводка).
BOT_TOKEN=ваш_токен_бота_от_botfather

# ==== НЕОБЯЗАТЕЛЬНО (есть значения по умолчанию) ====

# Часовой пояс и время ежедневной рассылки.
TIMEZONE=Europe/Moscow
SEND_HOUR=8
SEND_MINUTE=0

# Параметры краткой выжимки.
SUMMARY_MAX_SENTENCES=2
SUMMARY_MAX_CHARS=400

# Сколько последних сообщений просматривать в каждом канале (защита от перебора).
MAX_MESSAGES_PER_CHANNEL=400

# Список каналов через запятую (если не задан — берётся встроенный список из config.py).
# CHANNELS=prbezposhady,blogbankir,banksta
